<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_bosta" model="ir.ui.view">
        <field name="name">delivery.carrier.form.bosta</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='destination']" position="before">
                <page string="Bosta" name="bosta" invisible="delivery_type != 'bosta'">
                    <group>
                        <field name="bosta_api_key" password="True" required="delivery_type == 'bosta'"/>
                        <field name="bosta_webhook_secret" password="True"/>
                        <field name="fixed_price" string="Price Charged to Customers"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
